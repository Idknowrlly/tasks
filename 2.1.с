#include<stdio.h>
#include<math.h>
#include<stdlib.h>
#include<locale.h>
#include <float.h>

/**
 * @brief проверяет существование треугольника
 * @param sideAB первая сторона треугольника
 * @param sideBC вторая сторона треугольника
 * @param sideAC вторая сторона треугольника
 */
void checkExistenceTriangle(const double sideAB, const double sideBC, const double sideAC);

/**
 * @brief рассчитывает периметр треугольника
 * @param sideAB первая сторона треугольника
 * @param sideBC вторая сторона треугольника
 * @param sideAC вторая сторона треугольника
 * @return возвращает рассчитанный Периметр
 */
double getTrianglePerimetr(const double sideAB, const double sideBC, const double sideAC);

/**
 * @brief рассчитывает площадь треугольника
 * @param sideAB первая сторона треугольника
 * @param sideBC вторая сторона треугольника
 * @param sideAC вторая сторона треугольника
 * @return возвращает рассчитанную площадь
 */
double getTriangleSquare(const double sideAB, const double sideBC, const double sideAC, const double HalfPerimetr);

/**
 * @brief считывает значение,
 * введенное с клавиатуры с проверкой ввода
 * @return считанное значение
 */
double getValue();

/**
 * @brief проверяет,что переменная равна одному или двум
 * @return возвращает значение переменной check если она является одному или двум
 */
double getCheck();

/**
 * @brief выбирает рассчитать площадь или периметр по константе
 * @param check - константа по которой производиться выбор
 * @param sideAB первая сторона треугольника
 * @param sideBC вторая сторона треугольника
 * @param sideAC вторая сторона треугольника
 * @param HalfPerimetr - полупериметр треугольника
 * @return возвращает результат площади или периметра зависимости от выбора
 */
void getChoice(const double check, const double sideAB, const double sideBC, const double sideAC, const double HalfPerimetr);

/**
 * @brief рассчитывает сторону треугольника
 * @param xA - координата х первой точки
 * @param yA - координата y первой точки
 * @param xB - координата х второй точки
 * @param yB - координата y второй точки
 * @return возвращает рассчитаную сторону треугольника
 */
double getSide(const double xA, const double yA, const double xB, const double yB);

/**
* @brief Точка входа в программу
* @return возвращает 0, если прогамма выполнена корректно
*/
int main(void)
{
	setlocale(LC_ALL, "Russian");
	double xA = 0, yA = 0, xB = 0, yB = 0, xC = 0, yC = 0;
	printf("Введите координаты точки A(x,y) через пробел:\n");
	xA = getValue();
	yA = getValue();
	printf("Введите координаты точки C(x,y) через пробел:\n");
	xB = getValue();
	yB = getValue();
	printf("Введите координаты точки C(x,y) через пробел:\n");
	xC = getValue();
	yC = getValue();
	double sideAB = 0, sideBC = 0, sideAC = 0;
	sideAB = getSide(xA, yA, xB, yB);
	sideBC = getSide(xB, yB, xC, yC);
	sideAC = getSide(xA, yA, xC, yC);
	checkExistenceTriangle(sideAB, sideBC, sideAC);
	int check = 0;
	printf("Выберите, что хотите рассчитать(1 - Периметр, 2 - Площадь:)\n");
	check = getCheck();
	double HalfPerimetr = 0;
	HalfPerimetr = getTrianglePerimetr(sideAB, sideBC, sideAC) / 2;
	getChoice(check, sideAB, sideBC, sideAC, HalfPerimetr);
	return 0;
}

double getSide(const double xA, const double yA, const double xB, const double yB)
{
	return sqrt(pow(xA - xB, 2) + pow(yA - yB, 2));
}


double getTrianglePerimetr(const double sideAB, const double sideBC, const double sideAC)
{
	return sideAB + sideBC + sideAC;
}

double getTriangleSquare(const double sideAB, const double sideBC, const double sideAC, const double HalfPerimetr)
{
	return sqrt(HalfPerimetr * (HalfPerimetr - sideAB) * (HalfPerimetr - sideBC) * (HalfPerimetr - sideAC));
}

void checkExistenceTriangle(const double sideAB, const double sideBC, const double sideAC)
{
	if (!((sideAB + sideBC > sideAC) & (sideAC + sideBC > sideAB) & (sideAB + sideAC > sideBC)))
	{
		printf("Данного треугольника не существует\n");
		exit(1);
	}
}

double getValue()
{
	double value = 0;
	if (!scanf_s("%lf", &value))
	{
		printf("Error\n");
		abort();
	}
	return value;
}

double getCheck()
{
	int check = 0;
	if (!scanf_s("%d", &check))
	{
		printf("Вы сделали неправильный выбор\n");
		abort();
	}
	else
	{
		if (check == 1 || check == 2)
		{
			return check;
		}
	}
	printf("Вы сделали неправильный выбор\n");
	abort();
}

void getChoice(const double check, const double sideAB, const double sideBC, const double sideAC, const double HalfPerimetr)
{
	if (check == 1)
	{
		printf("Периметр данного треугольника равен: %.2lf", getTrianglePerimetr(sideAB, sideBC, sideAC));
	}
	else
	{
		printf("Площадь данного треугольника равна: %.2lf", getTriangleSquare(sideAB, sideBC, sideAC, HalfPerimetr));
	}
}
